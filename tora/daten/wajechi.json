            {
              "id": "47-30-2",
              "t": "zu meinen Vätern,"
            },
            {
              "id": "47-30-3",
              "t": "so trage mich"
            },
            {
              "id": "47-30-4",
              "t": "aus Ägypten fort"
            },
            {
              "id": "47-30-5",
              "t": "und begrabe mich"
            },
            {
              "id": "47-30-6",
              "t": "in ihrem Grab."
            },
            {
              "id": "47-30-7",
              "t": "Er sprach:"
            },
            {
              "id": "47-30-8",
              "t": "Ich"
            },
            {
              "id": "47-30-9",
              "t": "will tun,"
            },
            {
              "id": "47-30-10",
              "t": "wie du gesagt hast."
            }
          ]
        },
        {
          "ref": "47,31",
          "he": [
            {
              "id": "47-31-1",
              "t": "וַיֹּ֗אמֶר"
